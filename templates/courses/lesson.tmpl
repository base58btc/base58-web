        progress.courses[courseSlug].lessons[block.lessonPath] = progress.courses[courseSlug].lessons[block.lessonPath] || { blocks: {}, codeBlocks: {} };
        const lesson = progress.courses[courseSlug].lessons[block.lessonPath];
        lesson.blocks = lesson.blocks || {};
        lesson.codeBlocks = lesson.codeBlocks || {};
        const target = block.blockType === "code-cell" ? lesson.codeBlocks : lesson.blocks;
        const saved = target[block.blockId] || {};
        target[block.blockId] = Object.assign(saved, {
          blockId: block.blockId,
          blockType: block.blockType || saved.blockType || "",
          codeText: block.codeText || "",
          outputText: block.outputText || "",
          outputOk: typeof block.outputOk === "boolean" ? block.outputOk : null,
          executionCount: Number.isInteger(block.executionCount) ? block.executionCount : null,
          answeredAt: block.updatedAt || saved.answeredAt || new Date().toISOString()
        });
      });
