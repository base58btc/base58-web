      restoreCurrentLessonProgress();
    }

    function restoreCurrentLessonProgress() {
      const shell = document.querySelector(".course-platform_shell");
      if (!shell) {
        return;
      }

      const lesson = getStoredCourseLesson(shell.dataset.courseSlug || "", shell.dataset.lessonPath || "");
      document.querySelectorAll(".course-multiple-choice, .course-code-challenge").forEach(function(block) {
        const saved = lesson.blocks[block.dataset.courseBlockId || ""];
        if (!saved) {
