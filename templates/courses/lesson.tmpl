<!DOCTYPE html>
<html>
<head>
  {{ block "head" .Page }} {{ end }}
  <style>
    .course-platform {
      background: #f8f7f3;
      min-height: 100vh;
    }

    .course-platform_shell {
      display: grid;
      grid-template-columns: minmax(13rem, 18rem) minmax(0, 1fr);
      gap: 3rem;
      width: min(100%, 76rem);
      margin: 0 auto;
      padding: 7rem 2rem 5rem;
    }

    .course-platform_sidebar {
      align-self: start;
      position: sticky;
      top: 1.5rem;
      max-height: calc(100vh - 3rem);
      overflow: auto;
      padding-right: 1rem;
      border-right: 1px solid rgba(20, 20, 20, 0.12);
    }

    .course-platform_course-title {
      margin: 0 0 1.25rem;
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .course-platform_nav {
      display: grid;
      gap: 0.25rem;
    }

    .course-platform_nav-item {
      display: block;
    }

    .course-platform_nav-link {
      display: grid;
      grid-template-columns: 2.4rem minmax(0, 1fr);
      align-items: start;
      gap: 0.75rem;
      width: 100%;
      padding: 0.625rem 0.75rem;
      border-radius: 0.375rem;
      color: #191919;
      text-decoration: none;
    }

    .course-platform_nav-link:hover {
      background: #eeebe3;
    }

    .course-platform_nav-link.is-active {
      background: #eeebe3;
    }

    .course-platform_nav-link.is-current {
      background: #191919;
      color: #fff;
    }

    .course-platform_nav-number {
      color: #8f6b32;
      font-size: 0.75rem;
      font-weight: 700;
      line-height: 1.4;
    }

    .course-platform_nav-link.is-current .course-platform_nav-number {
      color: #f7c35f;
    }

    .course-platform_nav-title {
      min-width: 0;
      font-size: 0.9375rem;
      font-weight: 600;
      line-height: 1.35;
    }

    .course-platform_subpages {
      display: grid;
      gap: 0.125rem;
      margin: 0.25rem 0 0.5rem 1.25rem;
      padding-left: 0.75rem;
      border-left: 1px solid rgba(20, 20, 20, 0.12);
    }

    .course-platform_subpages .course-platform_nav-link {
      grid-template-columns: 2rem minmax(0, 1fr);
      padding: 0.5rem 0.625rem;
    }

    .course-platform_content {
      min-width: 0;
      max-width: 47rem;
    }

    .course-platform_current {
      margin: 0 0 1rem;
      color: #73592f;
      font-size: 0.875rem;
      font-weight: 700;
    }

    .course-platform_article {
      color: #191919;
      font-size: 1.0625rem;
      line-height: 1.7;
    }

    .course-platform_article h1 {
      margin: 0 0 1rem;
      font-size: clamp(2rem, 5vw, 4.5rem);
      line-height: 0.98;
      letter-spacing: 0;
    }

    .course-platform_article h2 {
      margin: 2.25rem 0 0.75rem;
      font-size: 1.75rem;
      line-height: 1.15;
      letter-spacing: 0;
    }

    .course-platform_article h3 {
      margin: 1.75rem 0 0.5rem;
      font-size: 1.25rem;
      line-height: 1.25;
      letter-spacing: 0;
    }

    .course-platform_article p,
    .course-platform_article ul,
    .course-platform_article ol,
    .course-platform_article pre {
      margin: 0 0 1.125rem;
    }

    .course-platform_article ul,
    .course-platform_article ol {
      padding-left: 1.35rem;
    }

    .course-platform_article code {
      border-radius: 0.25rem;
      background: #eee8dc;
      padding: 0.125rem 0.3rem;
      font-size: 0.95em;
    }

    .course-platform_article pre {
      overflow-x: auto;
      border-radius: 0.5rem;
      background: #191919;
      color: #fff;
      padding: 1rem;
    }

    .course-platform_article pre code {
      background: transparent;
      padding: 0;
      color: inherit;
    }

    .codeset {
      display: grid;
      grid-template-columns: 4.25rem minmax(0, 1fr);
      column-gap: 0.5rem;
      row-gap: 0.75rem;
      align-items: flex-start;
      margin: 1.25rem 0;
    }

    .codeset .run-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border: 1px solid rgba(20, 20, 20, 0.16);
      border-radius: 0.375rem;
      background: #191919;
      color: #f7c35f;
      cursor: pointer;
      justify-self: end;
    }

    .codeset .run-btn:disabled {
      cursor: wait;
      opacity: 0.62;
    }

    .codeset .code-area {
      width: 100%;
      min-height: 8rem;
      resize: vertical;
      border: 1px solid rgba(20, 20, 20, 0.16);
      border-radius: 0.5rem;
      background: #fffdf8;
      padding: 0.85rem 1rem;
      color: #191919;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.925rem;
      line-height: 1.5;
    }

    .codeset .output-prompt {
      min-height: 2.5rem;
      padding-top: 0.75rem;
      color: #73592f;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.8125rem;
      font-weight: 700;
      line-height: 1.5;
      text-align: right;
      white-space: nowrap;
    }

    .codeset .output {
      width: 100%;
      min-height: 2.5rem;
      border-radius: 0.5rem;
      background: #eee8dc;
      padding: 0.75rem 1rem;
      white-space: pre-wrap;
      color: #25301a;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .codeset .output.is-error {
      color: #8a2d22;
    }

    .course-challenge {
      margin: 1.5rem 0;
      border: 1px solid rgba(20, 20, 20, 0.12);
      border-radius: 0.5rem;
      background: #fffdf8;
      padding: 1rem;
    }

    .course-challenge-prompt > :last-child {
      margin-bottom: 0;
    }

    .course-choice-list {
      display: grid;
      gap: 0.5rem;
      margin: 1rem 0;
      border: 0;
      padding: 0;
    }

    .course-choice {
      display: grid;
      grid-template-columns: 1rem 2rem minmax(0, 1fr);
      gap: 0.625rem;
      align-items: start;
      border: 1px solid rgba(20, 20, 20, 0.12);
      border-radius: 0.375rem;
      background: #f8f7f3;
      padding: 0.625rem 0.75rem;
      cursor: pointer;
    }

    .course-choice-input {
      margin: 0.25rem 0 0;
    }

    .course-choice-letter {
      color: #73592f;
      font-weight: 800;
      line-height: 1.45;
    }

    .course-choice-body {
      display: grid;
      gap: 0.35rem;
      min-width: 0;
    }

    .course-choice-explanation {
      color: #5f5445;
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .course-choice.is-correct-answer {
      border-color: rgba(47, 111, 78, 0.62);
      background: #eef7f1;
    }

    .course-choice.is-incorrect-answer {
      border-color: rgba(138, 45, 34, 0.5);
      background: #fff1ee;
    }

    .course-choice-input:disabled {
      cursor: default;
    }

    .course-challenge-actions {
      display: flex;
      justify-content: flex-start;
      gap: 0.5rem;
    }

    .course-challenge-submit {
      border: 1px solid rgba(20, 20, 20, 0.16);
      border-radius: 0.375rem;
      background: #191919;
      padding: 0.55rem 0.85rem;
      color: #f7c35f;
      font-weight: 800;
      cursor: pointer;
    }

    .course-challenge-submit:disabled {
      cursor: default;
      opacity: 0.62;
    }

    .course-challenge-feedback {
      margin-top: 0.75rem;
      border-radius: 0.375rem;
      background: #eee8dc;
      padding: 0.625rem 0.75rem;
      font-weight: 700;
    }

    .course-challenge.is-correct .course-challenge-feedback,
    .course-code-challenge.is-correct .challenge-output {
      color: #2f6f4e;
    }

    .course-challenge.is-incorrect .course-challenge-feedback,
    .course-code-challenge.is-incorrect .challenge-output {
      color: #8a2d22;
    }

    .course-code-challenge .code-challenge-cell {
      margin-bottom: 0;
    }

    .course-authoring-error {
      border-color: rgba(138, 45, 34, 0.5);
      background: #fff1ee;
      color: #8a2d22;
    }

    .course-authoring-error p {
      margin-bottom: 0;
    }

    .course-platform_pager {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(20, 20, 20, 0.12);
    }

    .course-platform_pager-link {
      display: grid;
      gap: 0.25rem;
      max-width: 48%;
      color: #191919;
      text-decoration: none;
    }

    .course-platform_pager-link.next {
      margin-left: auto;
      text-align: right;
    }

    .course-platform_pager-label {
      color: #73592f;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .course-platform_pager-title {
      font-weight: 700;
      line-height: 1.3;
    }

    .course-scroll-indicator {
      --scroll-progress: 0;
      position: fixed;
      right: 1rem;
      top: 50%;
      z-index: 20;
      display: grid;
      justify-items: center;
      gap: 0.5rem;
      transform: translateY(-50%);
      pointer-events: none;
    }

    .course-scroll-track {
      position: relative;
      width: 0.375rem;
      height: 8rem;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(25, 25, 25, 0.12);
    }

    .course-scroll-fill {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      height: 100%;
      border-radius: inherit;
      background: #191919;
      transform: scaleY(var(--scroll-progress));
      transform-origin: top;
    }

    @media screen and (max-width: 860px) {
      .course-platform_shell {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 5rem 1.25rem 3rem;
      }

      .course-platform_sidebar {
        position: relative;
        top: auto;
        max-height: none;
        padding: 0 0 1.25rem;
        border-right: 0;
        border-bottom: 1px solid rgba(20, 20, 20, 0.12);
      }

      .course-platform_content {
        max-width: none;
      }

      .course-scroll-indicator {
        right: 0.75rem;
        top: auto;
        bottom: 0.75rem;
        gap: 0.375rem;
        transform: none;
      }

      .course-scroll-track {
        width: 5.5rem;
        height: 0.25rem;
      }

      .course-scroll-fill {
        transform: scaleX(var(--scroll-progress));
        transform-origin: left;
      }
    }
  </style>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      updateCourseScrollProgress();
    });

    window.addEventListener("scroll", requestCourseScrollProgressUpdate, { passive: true });
    window.addEventListener("resize", requestCourseScrollProgressUpdate);

    let scrollProgressFrame = 0;

    function requestCourseScrollProgressUpdate() {
      if (scrollProgressFrame) {
        return;
      }

      scrollProgressFrame = window.requestAnimationFrame(function() {
        scrollProgressFrame = 0;
        updateCourseScrollProgress();
      });
    }

    function updateCourseScrollProgress() {
      const indicator = document.querySelector(".course-scroll-indicator");
      if (!indicator) {
        return;
      }

      const scroller = document.scrollingElement || document.documentElement;
      const maxScroll = Math.max(0, scroller.scrollHeight - window.innerHeight);
      const progress = maxScroll === 0 ? 1 : Math.min(1, Math.max(0, scroller.scrollTop / maxScroll));
      indicator.style.setProperty("--scroll-progress", progress.toFixed(4));
    }

    document.addEventListener("keydown", function(event) {
      const target = event.target;
      const isCodeArea = target instanceof HTMLTextAreaElement && target.classList.contains("code-area");

      if (isCodeArea && event.key === "Enter" && (event.metaKey || event.ctrlKey)) {
        const challenge = target.closest(".course-code-challenge");
        if (challenge && typeof submitCodeChallenge === "function") {
          const button = challenge.querySelector(".course-challenge-submit");
          if (button) {
            event.preventDefault();
            submitCodeChallenge(button);
          }
          return;
        }

        const cell = target.closest(".cell");
        const button = cell ? cell.querySelector(".run-btn") : null;
        if (button && typeof runCellCode === "function") {
          event.preventDefault();
          runCellCode(button);
        }
        return;
      }

      if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) {
        return;
      }

      if (isEditableTarget(target)) {
        return;
      }

      const shell = document.querySelector(".course-platform_shell");
      if (!shell) {
        return;
      }

      let destination = "";
      if (event.key === "ArrowLeft" || event.key === "[") {
        destination = shell.dataset.prevUrl || "";
      }
      if (event.key === "ArrowRight" || event.key === "]") {
        destination = shell.dataset.nextUrl || "";
      }

      if (destination) {
        event.preventDefault();
        window.location.href = destination;
      }
    });

    function isEditableTarget(target) {
      if (!(target instanceof Element)) {
        return false;
      }
      return Boolean(target.closest("input, textarea, select, [contenteditable='true']"));
    }

    function submitMultipleChoice(button) {
      const block = button.closest(".course-multiple-choice");
      if (!block) {
        return;
      }

      const feedback = block.querySelector(".course-challenge-feedback");
      const selectedChoices = Array.from(block.querySelectorAll(".course-choice-input:checked")).map(function(input) {
        return input.closest(".course-choice");
      }).filter(Boolean);
      if (selectedChoices.length === 0) {
        if (feedback) {
          feedback.hidden = false;
          feedback.textContent = "Choose at least one answer first.";
        }
        return;
      }

      const correctChoices = Array.from(block.querySelectorAll(".course-choice[data-correct='true']"));
      const selectedIndexes = selectedChoices.map(function(choice) {
        return choice.dataset.choiceIndex;
      }).sort();
      const correctIndexes = correctChoices.map(function(choice) {
        return choice.dataset.choiceIndex;
      }).sort();
      const correct = selectedIndexes.length === correctIndexes.length && selectedIndexes.every(function(index, position) {
        return index === correctIndexes[position];
      });

      block.querySelectorAll(".course-choice").forEach(function(choice) {
        choice.classList.remove("is-selected-answer", "is-correct-answer", "is-incorrect-answer");
        const explanation = choice.querySelector(".course-choice-explanation");
        if (explanation) {
          explanation.hidden = true;
        }
      });

      correctChoices.forEach(function(choice) {
        choice.classList.add("is-correct-answer");
      });
      selectedChoices.forEach(function(choice) {
        choice.classList.add("is-selected-answer");
        choice.classList.toggle("is-incorrect-answer", choice.dataset.correct !== "true");
        const explanation = choice.querySelector(".course-choice-explanation");
        if (explanation) {
          explanation.hidden = false;
        }
      });

      block.querySelectorAll(".course-choice-input").forEach(function(input) {
        input.disabled = true;
      });
      button.disabled = true;

      if (feedback) {
        feedback.hidden = false;
        feedback.textContent = correct ? "Correct." : "Not quite.";
      }

      markCourseBlockResult(block, {
        correct: correct,
        selectedOption: selectedIndexes.length === 1 ? selectedIndexes[0] : null,
        selectedOptions: selectedIndexes
      });
    }

    function markCourseBlockResult(block, result) {
      if (!block) {
        return;
      }

      const correct = Boolean(result && result.correct);
      block.dataset.courseBlockCorrect = correct ? "true" : "false";
      block.classList.add("is-answered");
      block.classList.toggle("is-correct", correct);
      block.classList.toggle("is-incorrect", !correct);

      const shell = document.querySelector(".course-platform_shell");
      window.dispatchEvent(new CustomEvent("course:block-result", {
        detail: {
          blockId: block.dataset.courseBlockId || "",
          blockType: block.dataset.courseBlockType || "",
          correct: correct,
          selectedOption: result && result.selectedOption ? result.selectedOption : null,
          selectedOptions: result && result.selectedOptions ? result.selectedOptions : [],
          courseSlug: shell ? shell.dataset.courseSlug || "" : "",
          lessonPath: shell ? shell.dataset.lessonPath || "" : ""
        }
      }));
    }

    function decodeCourseBlockData(value) {
      if (!value) {
        return "";
      }

      const bytes = Uint8Array.from(window.atob(value), function(char) {
        return char.charCodeAt(0);
      });
      return new TextDecoder().decode(bytes);
    }
  </script>
  {{ if .HasCode }}
  <script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>
  <script>
    let pyodideReady;
    let courseCellRunnerReady = false;
    let courseExecutionCount = 0;

    const courseCellRunnerSource = `
import ast
import json
import sys
import traceback
from io import StringIO

def __course_exec_cell(code):
    tree = ast.parse(code, filename="<course cell>", mode="exec")
    if tree.body and isinstance(tree.body[-1], ast.Expr):
        body = ast.Module(body=tree.body[:-1], type_ignores=tree.type_ignores)
        ast.fix_missing_locations(body)
        if body.body:
            exec(compile(body, "<course cell>", "exec"), globals())

        expr = ast.Expression(tree.body[-1].value)
        ast.fix_missing_locations(expr)
        value = eval(compile(expr, "<course cell>", "eval"), globals())
        sys.displayhook(value)
        return

    exec(compile(tree, "<course cell>", "exec"), globals())

def __course_run_cell(code):
    old_stdout = sys.stdout
    old_stderr = sys.stderr
    stdout = StringIO()
    stderr = StringIO()
    sys.stdout = stdout
    sys.stderr = stderr
    ok = True

    try:
        __course_exec_cell(code)
    except BaseException:
        ok = False
        traceback.print_exc(file=sys.stderr)
    finally:
        output = stdout.getvalue() + stderr.getvalue()
        sys.stdout = old_stdout
        sys.stderr = old_stderr

    return json.dumps({"ok": ok, "output": output})

def __course_check_cell(student_code, check_code):
    old_stdout = sys.stdout
    old_stderr = sys.stderr
    stdout = StringIO()
    stderr = StringIO()
    sys.stdout = stdout
    sys.stderr = stderr
    ok = True
    phase = "student"

    try:
        exec(compile(student_code, "<course challenge>", "exec"), globals())
        phase = "check"
        exec(compile(check_code, "<course checks>", "exec"), globals())
    except BaseException:
        ok = False
        if phase == "student":
            traceback.print_exc(file=sys.stderr)
    finally:
        output = stdout.getvalue() + stderr.getvalue()
        sys.stdout = old_stdout
        sys.stderr = old_stderr

    return json.dumps({"ok": ok, "output": output, "phase": phase})
`;

    async function getCoursePyodide() {
      if (!pyodideReady) {
        pyodideReady = (async function() {
          if (typeof loadPyodide !== "function") {
            throw new Error("Pyodide failed to load");
          }
          return await loadPyodide();
        })();
      }
      const pyodide = await pyodideReady;
      if (!courseCellRunnerReady) {
        pyodide.runPython(courseCellRunnerSource);
        courseCellRunnerReady = true;
      }
      return pyodide;
    }

    async function runCellCode(button) {
      const cell = button.closest(".cell");
      const textarea = cell.querySelector(".code-area");
      const output = cell.querySelector(".output");
      const prompt = cell.querySelector(".output-prompt");
      output.classList.remove("is-error");
      output.textContent = "Running...";
      if (prompt) {
        prompt.textContent = "Out[*]:";
      }
      button.disabled = true;

      try {
        const pyodide = await getCoursePyodide();
        pyodide.globals.set("__course_cell_code", textarea.value);
        const result = JSON.parse(pyodide.runPython("__course_run_cell(__course_cell_code)"));
        const executionCount = ++courseExecutionCount;
        output.classList.toggle("is-error", !result.ok);
        output.textContent = result.output;
        if (prompt) {
          prompt.textContent = result.ok ? "Out[" + executionCount + "]:" : "Err[" + executionCount + "]:";
        }
      } catch (err) {
        const executionCount = ++courseExecutionCount;
        output.classList.add("is-error");
        output.textContent = err.message;
        if (prompt) {
          prompt.textContent = "Err[" + executionCount + "]:";
        }
      } finally {
        button.disabled = false;
      }
    }

    async function submitCodeChallenge(button) {
      const block = button.closest(".course-code-challenge");
      if (!block) {
        return;
      }

      const textarea = block.querySelector(".code-area");
      const output = block.querySelector(".challenge-output");
      let keepDisabled = false;

      output.classList.remove("is-error");
      output.textContent = "Checking...";
      button.disabled = true;

      try {
        const pyodide = await getCoursePyodide();
        const checkCode = decodeCourseBlockData(block.dataset.checkCode || "");
        const failureMessage = decodeCourseBlockData(block.dataset.failureMessage || "") || "Not quite. Try again.";
        pyodide.globals.set("__course_challenge_code", textarea.value);
        pyodide.globals.set("__course_challenge_check", checkCode);
        const result = JSON.parse(pyodide.runPython("__course_check_cell(__course_challenge_code, __course_challenge_check)"));

        if (result.ok) {
          output.textContent = result.output ? result.output + "\nCorrect." : "Correct.";
          textarea.disabled = true;
          keepDisabled = true;
          markCourseBlockResult(block, { correct: true });
          return;
        }

        output.classList.add("is-error");
        output.textContent = result.phase === "student" && result.output ? result.output : failureMessage;
        markCourseBlockResult(block, { correct: false });
      } catch (err) {
        output.classList.add("is-error");
        output.textContent = err.message;
        markCourseBlockResult(block, { correct: false });
      } finally {
        button.disabled = keepDisabled;
      }
    }
  </script>
  {{ end }}
</head>
<body>
  <div class="page-wrapper course-platform">
    {{ block "nav" .Page }} {{ end }}
    <div class="course-scroll-indicator" aria-hidden="true">
      <div class="course-scroll-track">
        <div class="course-scroll-fill"></div>
      </div>
    </div>
    <main class="course-platform_shell" data-course-slug="{{ .CourseSlug }}" data-lesson-path="{{ .Current.Path }}"{{ if .Previous }} data-prev-url="{{ .Previous.URL }}"{{ end }}{{ if .Next }} data-next-url="{{ .Next.URL }}"{{ end }}>
      <aside class="course-platform_sidebar" aria-label="Course pages">
        <h2 class="course-platform_course-title">{{ .CourseTitle }}</h2>
        <nav class="course-platform_nav">
          {{ range .Sidebar }}
            <div class="course-platform_nav-item">
              <a href="{{ .URL }}" class="course-platform_nav-link{{ if .Current }} is-current{{ else if .Active }} is-active{{ end }}"{{ if .Current }} aria-current="page"{{ end }}>
                <span class="course-platform_nav-number">{{ .Number }}</span>
                <span class="course-platform_nav-title">{{ .Title }}</span>
              </a>
              {{ if and .Children .Active }}
                <div class="course-platform_subpages">
                  {{ range .Children }}
                    <a href="{{ .URL }}" class="course-platform_nav-link{{ if .Current }} is-current{{ else if .Active }} is-active{{ end }}"{{ if .Current }} aria-current="page"{{ end }}>
                      <span class="course-platform_nav-number">{{ .Number }}</span>
                      <span class="course-platform_nav-title">{{ .Title }}</span>
                    </a>
                  {{ end }}
                </div>
              {{ end }}
            </div>
          {{ end }}
        </nav>
      </aside>
      <section class="course-platform_content">
        <div class="course-platform_current">{{ .Current.DisplayNumber }} / {{ .Current.Title }}</div>
        <article class="course-platform_article">
          {{ .ContentHTML }}
        </article>
        <nav class="course-platform_pager" aria-label="Course page navigation">
          {{ if .Previous }}
            <a class="course-platform_pager-link previous" href="{{ .Previous.URL }}">
              <span class="course-platform_pager-label">Previous</span>
              <span class="course-platform_pager-title">{{ .Previous.Title }}</span>
            </a>
          {{ end }}
          {{ if .Next }}
            <a class="course-platform_pager-link next" href="{{ .Next.URL }}">
              <span class="course-platform_pager-label">Next</span>
              <span class="course-platform_pager-title">{{ .Next.Title }}</span>
            </a>
          {{ end }}
        </nav>
      </section>
    </main>
  </div>
  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=67d76c360ee76ed0c60f7a0e" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="/static/js/webflow.js" type="text/javascript"></script>
</body>
</html>
