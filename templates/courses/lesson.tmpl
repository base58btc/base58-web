    finally:
        output = stdout.getvalue() + stderr.getvalue()
        sys.stdout = old_stdout
        sys.stderr = old_stderr

    return json.dumps({"ok": ok, "output": output, "phase": phase})
`;

    async function getCoursePyodide() {
      if (!pyodideReady) {
        pyodideReady = (async function() {
          if (typeof loadPyodide !== "function") {
            throw new Error("Pyodide failed to load");
          }
          return await loadPyodide();
        })();
      }
      const pyodide = await pyodideReady;
      if (!courseCellRunnerReady) {
        pyodide.runPython(courseCellRunnerSource);
        courseCellRunnerReady = true;
      }
      return pyodide;
    }

    async function runCellCode(button) {
      const cell = button.closest(".cell");
      const textarea = cell.querySelector(".code-area");
      const output = cell.querySelector(".output");
      const prompt = cell.querySelector(".output-prompt");
      output.classList.remove("is-error");
      output.textContent = "Running...";
      if (prompt) {
        prompt.textContent = "Out[*]:";
      }
      button.disabled = true;

      try {
        const pyodide = await getCoursePyodide();
        pyodide.globals.set("__course_cell_code", textarea.value);
        const result = JSON.parse(pyodide.runPython("__course_run_cell(__course_cell_code)"));
        const executionCount = ++courseExecutionCount;
        output.classList.toggle("is-error", !result.ok);
        output.textContent = result.output;
        if (prompt) {
          prompt.textContent = result.ok ? "Out[" + executionCount + "]:" : "Err[" + executionCount + "]:";
        }
        saveRunnableCodeBlock(cell, result, executionCount);
      } catch (err) {
        const executionCount = ++courseExecutionCount;
        output.classList.add("is-error");
        output.textContent = err.message;
        if (prompt) {
          prompt.textContent = "Err[" + executionCount + "]:";
        }
        saveRunnableCodeBlock(cell, { ok: false, output: err.message }, executionCount);
      } finally {
        button.disabled = false;
      }
    }

    async function submitCodeChallenge(button) {
      const block = button.closest(".course-code-challenge");
      if (!block) {
        return;
      }

      const textarea = block.querySelector(".code-area");
      const output = block.querySelector(".challenge-output");

      output.classList.remove("is-error");
      output.textContent = "Checking...";
      button.disabled = true;

      try {
        const pyodide = await getCoursePyodide();
        const checkCode = decodeCourseBlockData(block.dataset.checkCode || "");
        const failureMessage = decodeCourseBlockData(block.dataset.failureMessage || "") || "Not quite. Try again.";
        pyodide.globals.set("__course_challenge_code", textarea.value);
        pyodide.globals.set("__course_challenge_check", checkCode);
        let result;
        try {
          result = JSON.parse(pyodide.runPython("__course_check_cell(__course_challenge_code, __course_challenge_check)"));
        } finally {
          pyodide.globals.delete("__course_challenge_code");
          pyodide.globals.delete("__course_challenge_check");
        }

        if (result.ok) {
          output.textContent = result.output ? result.output + "\nCorrect." : "Correct.";
          markCourseBlockResult(block, {
            correct: true,
            codeText: textarea.value,
            outputText: output.textContent,
            outputOk: true
          });
          return;
        }

        output.classList.add("is-error");
        output.textContent = result.phase === "student" && result.output ? result.output : failureMessage;
        markCourseBlockResult(block, {
          correct: false,
          codeText: textarea.value,
          outputText: output.textContent,
          outputOk: false
        });
      } catch (err) {
        output.classList.add("is-error");
        output.textContent = err.message;
        markCourseBlockResult(block, {
          correct: false,
          codeText: textarea.value,
          outputText: output.textContent,
          outputOk: false
        });
      } finally {
        button.disabled = false;
      }
    }
  </script>
  {{ end }}
</head>
<body>
  <div class="page-wrapper course-platform">
    {{ block "nav" .Page }} {{ end }}
    <a href="/dashboard" class="course-platform_top-dashboard-link">My Dashboard</a>
    <div class="course-scroll-indicator" aria-hidden="true">
      <div class="course-scroll-track">
        <div class="course-scroll-fill"></div>
      </div>
      <div class="course-challenge-markers" hidden></div>
    </div>
    <main class="course-platform_shell" data-course-slug="{{ .CourseSlug }}" data-lesson-path="{{ .Current.Path }}" data-csrf-token="{{ .CSRFToken }}"{{ if .Previous }} data-prev-url="{{ .Previous.URL }}"{{ end }}{{ if .Next }} data-next-url="{{ .Next.URL }}"{{ end }}>
      <aside class="course-platform_sidebar" aria-label="Course pages">
        <h2 class="course-platform_course-title">{{ .CourseTitle }}</h2>
        <nav class="course-platform_nav">
          {{ range .Sidebar }}
            <div class="course-platform_nav-item">
              <a href="{{ .URL }}" class="course-platform_nav-link{{ if .Current }} is-current{{ else if .Active }} is-active{{ end }}" data-lesson-path="{{ .Path }}" data-challenge-count="{{ .ChallengeCount }}"{{ if .Current }} aria-current="page"{{ end }}>
                <span class="course-platform_nav-number">{{ .Number }}</span>
                <span class="course-platform_nav-title">{{ .Title }}</span>
                <span class="course-platform_challenge-status" hidden></span>
              </a>
              {{ if and .Children .Active }}
                <div class="course-platform_subpages">
                  {{ range .Children }}
                    <a href="{{ .URL }}" class="course-platform_nav-link{{ if .Current }} is-current{{ else if .Active }} is-active{{ end }}" data-lesson-path="{{ .Path }}" data-challenge-count="{{ .ChallengeCount }}"{{ if .Current }} aria-current="page"{{ end }}>
                      <span class="course-platform_nav-number">{{ .Number }}</span>
                      <span class="course-platform_nav-title">{{ .Title }}</span>
                      <span class="course-platform_challenge-status" hidden></span>
                    </a>
                  {{ end }}
                </div>
              {{ end }}
            </div>
          {{ end }}
        </nav>
      </aside>
      <section class="course-platform_content">
        <div class="course-platform_current">{{ .Current.DisplayNumber }} / {{ .Current.Title }}</div>
        {{ if .HasNewVersion }}
          <div class="course-version-banner" role="status">
            <p>You are working on version {{ .VersionNumber }}. Version {{ .LatestVersionNumber }} is available.</p>
            <form method="post" action="/courses/{{ .CourseSlug }}/versions/latest/start">
              <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
              <button type="submit">Start Fresh on Latest Version</button>
            </form>
          </div>
        {{ end }}
        {{ if .HeroURL }}
          <figure class="course-hero">
            <img src="{{ .HeroURL }}" alt="{{ .HeroAlt }}" loading="lazy">
          </figure>
        {{ end }}
        <article class="course-platform_article">
          {{ .ContentHTML }}
        </article>
        <nav class="course-platform_pager" aria-label="Course page navigation">
          {{ if .Previous }}
            <a class="course-platform_pager-link previous" href="{{ .Previous.URL }}">
              <span class="course-platform_pager-label">Previous</span>
              <span class="course-platform_pager-title">{{ .Previous.Title }}</span>
            </a>
          {{ end }}
          {{ if .Next }}
            <a class="course-platform_pager-link next" href="{{ .Next.URL }}">
              <span class="course-platform_pager-label">Next</span>
              <span class="course-platform_pager-title">{{ .Next.Title }}</span>
            </a>
          {{ end }}
        </nav>
      </section>
    </main>
  </div>
  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=67d76c360ee76ed0c60f7a0e" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="/static/js/webflow.js" type="text/javascript"></script>
</body>
</html>
