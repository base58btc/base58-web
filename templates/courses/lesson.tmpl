def __course_display(value):
    if value is None:
        return

    if isinstance(value, (dict, list, tuple, set, frozenset)):
        print(pprint.pformat(value, width=72, compact=False, sort_dicts=False))
        return

    sys.displayhook(value)

def __course_exec_cell(code):
    tree = ast.parse(code, filename="<course cell>", mode="exec")
    if tree.body and isinstance(tree.body[-1], ast.Expr):
        body = ast.Module(body=tree.body[:-1], type_ignores=tree.type_ignores)
        ast.fix_missing_locations(body)
        if body.body:
            exec(compile(body, "<course cell>", "exec"), globals())

        expr = ast.Expression(tree.body[-1].value)
        ast.fix_missing_locations(expr)
        value = eval(compile(expr, "<course cell>", "eval"), globals())
        __course_display(value)
        return

    exec(compile(tree, "<course cell>", "exec"), globals())

def __course_run_cell(code):
    old_stdout = sys.stdout
    old_stderr = sys.stderr
    stdout = StringIO()
    stderr = StringIO()
    sys.stdout = stdout
    sys.stderr = stderr
    ok = True

    try:
        __course_exec_cell(code)
    except BaseException:
        ok = False
        traceback.print_exc(file=sys.stderr)
    finally:
        output = stdout.getvalue() + stderr.getvalue()
        sys.stdout = old_stdout
        sys.stderr = old_stderr

    return json.dumps({"ok": ok, "output": output})

def __course_challenge_globals():
    challenge_globals = {}
    for name, value in globals().items():
        if name.startswith("__course_"):
            continue
        challenge_globals[name] = value
    return challenge_globals

def __course_check_cell(student_code, check_code):
