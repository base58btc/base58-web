    function applySavedCourseBlockState(block, saved) {
      block.dataset.courseBlockCorrect = saved.correct ? "true" : "false";
      block.classList.add("is-answered");
      block.classList.toggle("is-correct", saved.correct === true);
      block.classList.toggle("is-incorrect", saved.correct !== true);

      const resultIcon = block.querySelector(".course-challenge-result-icon");
      if (resultIcon) {
        resultIcon.textContent = saved.correct ? "✓" : "×";
        resultIcon.setAttribute("aria-label", saved.correct ? "Correct" : "Incorrect");
      }

      if (block.classList.contains("course-multiple-choice")) {
        restoreMultipleChoiceState(block, saved);
      }
      if (block.classList.contains("course-code-challenge") && saved.correct === true) {
        const output = block.querySelector(".challenge-output");
        if (output && output.textContent.trim() === "") {
          output.textContent = "Correct.";
        }
      }
      if (block.classList.contains("course-code-challenge")) {
        applySavedCodeBlockState(block, saved);
      }
    }

    function applySavedCodeBlockState(block, saved) {
      const textarea = block.querySelector(".code-area");
      const output = block.querySelector(".output");
      const prompt = block.querySelector(".output-prompt");
      if (textarea && typeof saved.codeText === "string") {
        textarea.value = saved.codeText;
        normalizeCodeAreaTabs(textarea);
        resizeCodeArea(textarea);
        updateCodeHighlight(textarea);
      }
      if (output && typeof saved.outputText === "string" && saved.outputText !== "") {
        output.textContent = saved.outputText;
        output.classList.toggle("is-error", saved.outputOk === false);
      }
      if (prompt && Number.isInteger(saved.executionCount)) {
        prompt.textContent = saved.outputOk === false ? "Err[" + saved.executionCount + "]:" : "Out[" + saved.executionCount + "]:";
      }
    }

    function restoreMultipleChoiceState(block, saved) {
      const selected = Array.isArray(saved.selectedOptions) ? saved.selectedOptions : [];
      block.querySelectorAll(".course-choice").forEach(function(choice) {
        const input = choice.querySelector(".course-choice-input");
        const explanation = choice.querySelector(".course-choice-explanation");
        const isSelected = selected.includes(choice.dataset.choiceIndex);
        const isCorrect = choice.dataset.correct === "true";
        choice.classList.toggle("is-selected-answer", isSelected);
        choice.classList.toggle("is-correct-answer", isCorrect);
        choice.classList.toggle("is-incorrect-answer", isSelected && !isCorrect);
        if (input) {
          input.checked = isSelected;
          input.disabled = true;
        }
        if (explanation) {
          explanation.hidden = !(isSelected || isCorrect);
        }
      });
      const button = block.querySelector(".course-challenge-submit");
      if (button) {
        button.disabled = true;
      }
    }

    async function saveCourseBlockProgressToServer(detail) {
      if (!detail.courseSlug || !detail.lessonPath || !detail.blockId) {
        return;
      }
      const shell = document.querySelector(".course-platform_shell");

      try {
        await window.fetch("/api/courses/" + encodeURIComponent(detail.courseSlug) + "/progress", {
          method: "POST",
          credentials: "same-origin",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-CSRF-Token": shell ? shell.dataset.csrfToken || "" : ""
          },
          body: JSON.stringify({
            lessonPath: detail.lessonPath,
            blockId: detail.blockId,
            blockType: detail.blockType || "",
            correct: Boolean(detail.correct),
            selectedOption: detail.selectedOption || null,
            selectedOptions: Array.isArray(detail.selectedOptions) ? detail.selectedOptions : [],
            codeText: typeof detail.codeText === "string" ? detail.codeText : undefined,
            outputText: typeof detail.outputText === "string" ? detail.outputText : undefined,
            outputOk: typeof detail.outputOk === "boolean" ? detail.outputOk : undefined,
            executionCount: Number.isInteger(detail.executionCount) ? detail.executionCount : undefined
          })
        });
      } catch (err) {
        return;
      }
    }

    function saveRunnableCodeBlock(cell, result, executionCount) {
      const shell = document.querySelector(".course-platform_shell");
      const textarea = cell ? cell.querySelector(".code-area") : null;
      if (!shell || !cell || !textarea || !cell.dataset.courseBlockId) {
        return;
      }

      const detail = {
        blockId: cell.dataset.courseBlockId || "",
        blockType: cell.dataset.courseBlockType || "code-cell",
        correct: Boolean(result && result.ok),
        codeText: textarea.value,
        outputText: result && typeof result.output === "string" ? result.output : "",
        outputOk: Boolean(result && result.ok),
        executionCount: executionCount,
        courseSlug: shell.dataset.courseSlug || "",
        lessonPath: shell.dataset.lessonPath || ""
      };

      saveCourseBlockProgress(detail);
      saveCourseBlockProgressToServer(detail);
    }

    function getStoredCourseLesson(courseSlug, lessonPath) {
      const progress = readCourseProgress();
      const lesson = (((progress.courses[courseSlug] || {}).lessons || {})[lessonPath]) || { blocks: {}, codeBlocks: {} };
      lesson.blocks = lesson.blocks || {};
      lesson.codeBlocks = lesson.codeBlocks || {};
      return lesson;
    }

    function readCourseProgress() {
      if (!courseProgressState || courseProgressState.version !== 1 || !courseProgressState.courses) {
        courseProgressState = { version: 1, courses: {} };
      }
      return courseProgressState;
    }

    function writeCourseProgress(progress) {
      courseProgressState = progress && progress.version === 1 ? progress : { version: 1, courses: {} };
    }

    document.addEventListener("keydown", function(event) {
      const target = event.target;
      const isCodeArea = target instanceof HTMLTextAreaElement && target.classList.contains("code-area");

      if (isCodeArea && event.key === "Tab" && !event.metaKey && !event.ctrlKey && !event.altKey) {
        event.preventDefault();
        insertTextInCodeArea(target, codeIndent);
        return;
      }

      if (isCodeArea && event.key === "Enter" && (event.metaKey || event.ctrlKey)) {
        const challenge = target.closest(".course-code-challenge");
        if (challenge && typeof submitCodeChallenge === "function") {
          const button = challenge.querySelector(".course-challenge-submit");
          if (button) {
            event.preventDefault();
            submitCodeChallenge(button);
          }
          return;
        }

        const cell = target.closest(".cell");
        const button = cell ? cell.querySelector(".run-btn") : null;
        if (button && typeof runCellCode === "function") {
          event.preventDefault();
          runCellCode(button);
        }
        return;
      }

      if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) {
        return;
      }

      if (isEditableTarget(target)) {
        return;
      }

      const shell = document.querySelector(".course-platform_shell");
      if (!shell) {
        return;
      }

      let destination = "";
      if (event.key === "ArrowLeft" || event.key === "[") {
        destination = shell.dataset.prevUrl || "";
      }
      if (event.key === "ArrowRight" || event.key === "]") {
        destination = shell.dataset.nextUrl || "";
      }

      if (destination) {
        event.preventDefault();
        window.location.href = destination;
      }
    });

    function insertTextInCodeArea(textarea, text) {
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const scrollX = window.scrollX;
      const scrollY = window.scrollY;
      const textareaScrollTop = textarea.scrollTop;
      const textareaScrollLeft = textarea.scrollLeft;
      textarea.value = textarea.value.slice(0, start) + text + textarea.value.slice(end);
      textarea.selectionStart = start + text.length;
      textarea.selectionEnd = start + text.length;
      textarea.dispatchEvent(new Event("input", { bubbles: true }));
      textarea.scrollTop = textareaScrollTop;
      textarea.scrollLeft = textareaScrollLeft;
      window.scrollTo(scrollX, scrollY);
      window.requestAnimationFrame(function() {
        textarea.scrollTop = textareaScrollTop;
        textarea.scrollLeft = textareaScrollLeft;
        window.scrollTo(scrollX, scrollY);
      });
    }

    function setupAutoResizeCodeAreas() {
      document.querySelectorAll(".code-area").forEach(function(textarea) {
        normalizeCodeAreaTabs(textarea);
        resizeCodeArea(textarea);
        updateCodeHighlight(textarea);
        textarea.addEventListener("input", function() {
          normalizeCodeAreaTabs(textarea);
          resizeCodeArea(textarea);
          updateCodeHighlight(textarea);
        });
        textarea.addEventListener("scroll", function() {
          syncCodeHighlightScroll(textarea);
        });
      });
    }

    function resizeCodeArea(textarea) {
      if (!(textarea instanceof HTMLTextAreaElement)) {
        return;
      }

      const scrollX = window.scrollX;
      const scrollY = window.scrollY;
      textarea.style.height = "auto";
      textarea.style.height = textarea.scrollHeight + "px";

      const shell = textarea.closest(".code-editor-shell");
      if (shell) {
        shell.style.height = textarea.style.height;
      }
      window.scrollTo(scrollX, scrollY);
    }

    function normalizeCodeAreaTabs(textarea) {
      if (!(textarea instanceof HTMLTextAreaElement) || !textarea.value.includes("\t")) {
        return false;
      }

      const selectionStart = textarea.selectionStart;
      const selectionEnd = textarea.selectionEnd;
      const value = textarea.value;
      textarea.value = value.replace(/\t/g, codeIndent);
      textarea.selectionStart = normalizedCodeSelectionOffset(value, selectionStart);
      textarea.selectionEnd = normalizedCodeSelectionOffset(value, selectionEnd);
      return true;
    }

    function normalizedCodeSelectionOffset(value, offset) {
      const tabsBeforeOffset = (value.slice(0, offset).match(/\t/g) || []).length;
      return offset + tabsBeforeOffset * (codeIndent.length - 1);
    }

    function updateCodeHighlight(textarea) {
      const shell = textarea.closest(".code-editor-shell");
      const target = shell ? shell.querySelector(".code-highlight code") : null;
      if (!target) {
        return;
      }

      target.innerHTML = highlightPythonCode(textarea.value);
      syncCodeHighlightScroll(textarea);
    }

    function syncCodeHighlightScroll(textarea) {
      const shell = textarea.closest(".code-editor-shell");
      const highlight = shell ? shell.querySelector(".code-highlight") : null;
      if (!highlight) {
        return;
      }

      highlight.scrollTop = textarea.scrollTop;
      highlight.scrollLeft = textarea.scrollLeft;
    }

    function highlightPythonCode(code) {
      const keywords = new Set([
        "and", "as", "assert", "async", "await", "break", "class", "continue",
        "def", "del", "elif", "else", "except", "False", "finally", "for",
        "from", "global", "if", "import", "in", "is", "lambda", "None",
        "nonlocal", "not", "or", "pass", "raise", "return", "True", "try",
        "while", "with", "yield"
      ]);
      const builtins = new Set([
        "bool", "bytes", "dict", "enumerate", "float", "hex", "int", "len",
        "list", "max", "min", "print", "range", "set", "str", "sum", "tuple"
      ]);

      let out = "";
      let index = 0;
      while (index < code.length) {
        const char = code[index];

        if (char === "#") {
          const end = code.indexOf("\n", index);
          const next = end === -1 ? code.length : end;
          out += wrapCodeToken("comment", code.slice(index, next));
          index = next;
          continue;
        }

        if (char === "'" || char === '"') {
          const quote = char;
          const triple = code.slice(index, index + 3) === quote + quote + quote;
          let next = index + (triple ? 3 : 1);
          while (next < code.length) {
            if (!triple && code[next] === "\\") {
              next += 2;
              continue;
            }
            if (triple && code.slice(next, next + 3) === quote + quote + quote) {
              next += 3;
              break;
            }
            if (!triple && code[next] === quote) {
              next++;
              break;
            }
            next++;
          }
          out += wrapCodeToken("string", code.slice(index, next));
          index = next;
          continue;
        }

        const numberMatch = code.slice(index).match(/^\b\d+(?:_\d+)*(?:\.\d+(?:_\d+)*)?\b/);
        if (numberMatch) {
          out += wrapCodeToken("number", numberMatch[0]);
          index += numberMatch[0].length;
          continue;
        }

        const identifierMatch = code.slice(index).match(/^[A-Za-z_][A-Za-z0-9_]*/);
        if (identifierMatch) {
          const token = identifierMatch[0];
          if (keywords.has(token)) {
            out += wrapCodeToken("keyword", token);
          } else if (builtins.has(token)) {
            out += wrapCodeToken("builtin", token);
          } else {
            out += wrapCodeToken("variable", token);
          }
          index += token.length;
          continue;
        }

        if ("+-*/%=!<>&|^~:.,()[]{}".includes(char)) {
          out += wrapCodeToken("operator", char);
          index++;
          continue;
        }

        out += escapeCodeHTML(char);
        index++;
      }

      return out || "\n";
    }

    function wrapCodeToken(type, value) {
      return '<span class="code-token ' + type + '">' + escapeCodeHTML(value) + '</span>';
    }

    function escapeCodeHTML(value) {
      return value.replace(/[&<>"']/g, function(char) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;"
        }[char];
      });
    }

    function isEditableTarget(target) {
      if (!(target instanceof Element)) {
        return false;
      }
      return Boolean(target.closest("input, textarea, select, [contenteditable='true']"));
    }

    function submitMultipleChoice(button) {
      const block = button.closest(".course-multiple-choice");
      if (!block) {
        return;
      }

      const feedback = block.querySelector(".course-challenge-feedback");
      const resultIcon = block.querySelector(".course-challenge-result-icon");
      const selectedChoices = Array.from(block.querySelectorAll(".course-choice-input:checked")).map(function(input) {
        return input.closest(".course-choice");
      }).filter(Boolean);
      if (selectedChoices.length === 0) {
        if (resultIcon) {
          resultIcon.textContent = "";
        }
        if (feedback) {
          feedback.hidden = false;
          feedback.textContent = "Choose at least one answer first.";
        }
        return;
      }

      const correctChoices = Array.from(block.querySelectorAll(".course-choice[data-correct='true']"));
      const selectedIndexes = selectedChoices.map(function(choice) {
        return choice.dataset.choiceIndex;
      }).sort();
      const correctIndexes = correctChoices.map(function(choice) {
        return choice.dataset.choiceIndex;
      }).sort();
      const correct = selectedIndexes.length === correctIndexes.length && selectedIndexes.every(function(index, position) {
        return index === correctIndexes[position];
      });

      block.querySelectorAll(".course-choice").forEach(function(choice) {
        choice.classList.remove("is-selected-answer", "is-correct-answer", "is-incorrect-answer");
        const explanation = choice.querySelector(".course-choice-explanation");
        if (explanation) {
          explanation.hidden = true;
        }
      });

      correctChoices.forEach(function(choice) {
        choice.classList.add("is-correct-answer");
        const explanation = choice.querySelector(".course-choice-explanation");
        if (explanation) {
          explanation.hidden = false;
        }
      });
      selectedChoices.forEach(function(choice) {
        choice.classList.add("is-selected-answer");
        choice.classList.toggle("is-incorrect-answer", choice.dataset.correct !== "true");
        const explanation = choice.querySelector(".course-choice-explanation");
        if (explanation) {
          explanation.hidden = false;
        }
      });

      block.querySelectorAll(".course-choice-input").forEach(function(input) {
        input.disabled = true;
      });
      button.disabled = true;

      if (feedback) {
        feedback.hidden = true;
        feedback.textContent = "";
      }
      if (resultIcon) {
        resultIcon.textContent = correct ? "✓" : "×";
        resultIcon.setAttribute("aria-label", correct ? "Correct" : "Incorrect");
      }

      markCourseBlockResult(block, {
        correct: correct,
        selectedOption: selectedIndexes.length === 1 ? selectedIndexes[0] : null,
        selectedOptions: selectedIndexes
      });
    }

    function markCourseBlockResult(block, result) {
      if (!block) {
        return;
      }

      const correct = Boolean(result && result.correct);
      block.dataset.courseBlockCorrect = correct ? "true" : "false";
      block.classList.add("is-answered");
      block.classList.toggle("is-correct", correct);
      block.classList.toggle("is-incorrect", !correct);

      const resultIcon = block.querySelector(".course-challenge-result-icon");
      if (resultIcon) {
        resultIcon.textContent = correct ? "✓" : "×";
        resultIcon.setAttribute("aria-label", correct ? "Correct" : "Incorrect");
      }

      const shell = document.querySelector(".course-platform_shell");
      window.dispatchEvent(new CustomEvent("course:block-result", {
        detail: {
          blockId: block.dataset.courseBlockId || "",
          blockType: block.dataset.courseBlockType || "",
          correct: correct,
          selectedOption: result && result.selectedOption ? result.selectedOption : null,
          selectedOptions: result && result.selectedOptions ? result.selectedOptions : [],
          codeText: result && typeof result.codeText === "string" ? result.codeText : undefined,
          outputText: result && typeof result.outputText === "string" ? result.outputText : undefined,
          outputOk: result && typeof result.outputOk === "boolean" ? result.outputOk : undefined,
          courseSlug: shell ? shell.dataset.courseSlug || "" : "",
          lessonPath: shell ? shell.dataset.lessonPath || "" : ""
        }
      }));
    }

    function decodeCourseBlockData(value) {
      if (!value) {
        return "";
      }

      const bytes = Uint8Array.from(window.atob(value), function(char) {
        return char.charCodeAt(0);
      });
      return new TextDecoder().decode(bytes);
    }
  </script>
