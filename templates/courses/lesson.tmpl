<!DOCTYPE html>
<html>
<head>
  {{ block "head" .Page }} {{ end }}
  <style>
    .course-platform {
      background: #f8f7f3;
      min-height: 100vh;
    }

    .course-platform_shell {
      display: grid;
      grid-template-columns: minmax(13rem, 18rem) minmax(0, 1fr);
      gap: 6rem;
      width: min(100%, 76rem);
      margin: 0 auto;
      padding: 7rem 2rem 5rem;
    }

    .course-platform_sidebar {
      align-self: start;
      position: sticky;
      top: 1.5rem;
      max-height: calc(100vh - 3rem);
      overflow: auto;
      padding-right: 1rem;
      border-right: 1px solid rgba(20, 20, 20, 0.12);
    }

    .course-platform_course-title {
      margin: 0 0 1.25rem;
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .course-platform_top-dashboard-link {
      display: inline-flex;
      position: fixed;
      top: 1.1rem;
      right: 8rem;
      z-index: 1000;
      align-items: center;
      color: #fffdf8;
      padding: 0.55rem 0;
      font-weight: 800;
      text-decoration: none;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.38);
    }

    .course-platform_nav {
      display: grid;
      gap: 0.25rem;
    }

    .course-platform_nav-item {
      display: block;
    }

    .course-platform_nav-link {
      display: grid;
      grid-template-columns: 2.4rem minmax(0, 1fr) 0.875rem;
      align-items: start;
      gap: 0.75rem;
      width: 100%;
      padding: 0.625rem 0.75rem;
      border-radius: 0.375rem;
      color: #191919;
      text-decoration: none;
    }

    .course-platform_nav-link:hover {
      background: #eeebe3;
    }

    .course-platform_nav-link.is-active {
      background: #eeebe3;
    }

    .course-platform_nav-link.is-current {
      background: #191919;
      color: #fff;
    }

    .course-platform_nav-number {
      color: #8f6b32;
      font-size: 0.75rem;
      font-weight: 700;
      line-height: 1.4;
    }

    .course-platform_nav-link.is-current .course-platform_nav-number {
      color: #f7c35f;
    }

    .course-platform_nav-title {
      min-width: 0;
      font-size: 0.9375rem;
      font-weight: 600;
      line-height: 1.35;
    }

    .course-platform_challenge-status {
      display: inline-grid;
      place-items: center;
      width: 0.875rem;
      height: 0.875rem;
      margin-top: 0.1875rem;
      border: 1px solid rgba(25, 25, 25, 0.32);
      border-radius: 0.125rem;
      background: #f8f7f3;
      color: #fff;
      font-size: 0.625rem;
      font-weight: 900;
      line-height: 1;
      justify-self: end;
    }

    .course-platform_nav-link.is-current .course-platform_challenge-status {
      border-color: rgba(255, 255, 255, 0.55);
      background: transparent;
    }

    .course-platform_challenge-status[hidden] {
      display: none;
    }

    .course-platform_nav-link.is-complete .course-platform_challenge-status {
      border-color: #2f6f4e;
      background: #2f6f4e;
    }

    .course-platform_nav-link.is-attempted .course-platform_challenge-status {
      border-color: #8a2d22;
      background: #8a2d22;
    }

    .course-platform_subpages {
      display: grid;
      gap: 0.125rem;
      margin: 0.25rem 0 0.5rem 1.25rem;
      padding-left: 0.75rem;
      border-left: 1px solid rgba(20, 20, 20, 0.12);
    }

    .course-platform_subpages .course-platform_nav-link {
      grid-template-columns: 2rem minmax(0, 1fr) 0.875rem;
      padding: 0.5rem 0.625rem;
    }

    .course-platform_content {
      min-width: 0;
      max-width: 47rem;
    }

    .course-platform_current {
      margin: 0 0 1rem;
      color: #73592f;
      font-size: 0.875rem;
      font-weight: 700;
    }

    .course-version-banner {
      display: grid;
      gap: 0.75rem;
      margin: 0 0 1rem;
      border: 1px solid rgba(247, 147, 26, 0.5);
      border-radius: 0.5rem;
      background: #fff6e6;
      padding: 1rem;
      color: #191919;
    }

    .course-version-banner p {
      margin: 0;
      line-height: 1.45;
    }

    .course-version-banner form {
      margin: 0;
    }

    .course-version-banner button {
      border: 1.5px solid #191919;
      border-radius: 0.375rem;
      background: #f7931a;
      color: #191919;
      cursor: pointer;
      padding: 0.65rem 0.9rem;
      font: inherit;
      font-weight: 800;
    }

    .course-hero {
      margin: 0 0 1.5rem;
      overflow: hidden;
      border-radius: 0.5rem;
      background: #191919;
      aspect-ratio: 21 / 9;
    }

    .course-hero img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .course-platform_article {
      color: #191919;
      font-size: 1.0625rem;
      line-height: 1.7;
    }

    .course-platform_article h1 {
      margin: 0 0 1rem;
      font-size: clamp(2rem, 5vw, 4.5rem);
      line-height: 0.98;
      letter-spacing: 0;
    }

    .course-platform_article h2 {
      margin: 2.25rem 0 0.75rem;
      font-size: 1.75rem;
      line-height: 1.15;
      letter-spacing: 0;
    }

    .course-platform_article h3 {
      margin: 1.75rem 0 0.5rem;
      font-size: 1.25rem;
      line-height: 1.25;
      letter-spacing: 0;
    }

    .course-platform_article p,
    .course-platform_article ul,
    .course-platform_article ol,
    .course-platform_article pre {
      margin: 0 0 1.125rem;
    }

    .course-platform_article ul,
    .course-platform_article ol {
      padding-left: 1.35rem;
    }

    .course-platform_article ul {
      list-style: disc;
    }

    .course-platform_article ol {
      list-style: decimal;
    }

    .course-platform_article li {
      margin: 0.35rem 0;
    }

    .course-platform_article li > ul,
    .course-platform_article li > ol {
      margin: 0.35rem 0 0;
    }

    .course-platform_article code {
      border-radius: 0.25rem;
      background: #eee8dc;
      padding: 0.125rem 0.3rem;
      font-size: 0.95em;
    }

    .course-platform_article pre {
      overflow-x: auto;
      border-radius: 0.5rem;
      background: #191919;
      color: #fff;
      padding: 1rem;
    }

    .course-platform_article pre code {
      background: transparent;
      padding: 0;
      color: inherit;
    }

    .codeset {
      display: grid;
      grid-template-columns: 4.25rem minmax(0, 1fr);
      column-gap: 0.5rem;
      row-gap: 0.75rem;
      align-items: flex-start;
      width: calc(100% + 4.75rem);
      margin: 1.25rem 0 1.25rem -4.75rem;
    }

    .codeset .code-runner {
      align-self: stretch;
      justify-self: end;
      min-height: 100%;
    }

    .codeset .run-btn {
      position: sticky;
      top: 4.5rem;
      z-index: 5;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border: 1px solid rgba(20, 20, 20, 0.16);
      border-radius: 0.375rem;
      background: #191919;
      color: #f7c35f;
      cursor: pointer;
    }

    .codeset .run-btn:disabled {
      cursor: wait;
      opacity: 0.62;
    }

    .codeset .code-editor-shell {
      position: relative;
      box-sizing: border-box;
      width: 100%;
      min-height: 8rem;
      overflow: hidden;
      border: 1px solid rgba(20, 20, 20, 0.16);
      border-radius: 0.5rem;
      background: #fffdf8;
    }

    .codeset .code-highlight {
      position: absolute;
      inset: 0;
      box-sizing: border-box;
      margin: 0;
      overflow: hidden;
      border: 0;
      background: transparent;
      padding: 0.85rem 1rem;
      color: #191919;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.925rem;
      line-height: 1.5;
      pointer-events: none;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .codeset .code-highlight code {
      background: transparent;
      padding: 0;
      color: inherit;
      font: inherit;
    }

    .codeset .code-area {
      position: relative;
      z-index: 1;
      display: block;
      box-sizing: border-box;
      width: 100%;
      min-height: 8rem;
      overflow: hidden;
      resize: vertical;
      border: 0;
      background: transparent;
      padding: 0.85rem 1rem;
      color: transparent;
      caret-color: #191919;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.925rem;
      line-height: 1.5;
    }

    .codeset .code-area::selection {
      background: rgba(247, 195, 95, 0.42);
      color: transparent;
    }

    .code-token.keyword {
      color: #8b3f9f;
      font-weight: 700;
    }

    .code-token.builtin {
      color: #1d668f;
    }

    .code-token.string {
      color: #7a4b00;
    }

    .code-token.number {
      color: #2f6f4e;
    }

    .code-token.comment {
      color: #6b7280;
      font-style: italic;
    }

    .code-token.variable {
      color: #243b6b;
    }

    .code-token.operator {
      color: #8a2d22;
    }

    .codeset .output-prompt {
      min-height: 2.5rem;
      padding-top: 0.75rem;
      color: #73592f;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.8125rem;
      font-weight: 700;
      line-height: 1.5;
      text-align: right;
      white-space: nowrap;
    }

    .codeset .output {
      width: 100%;
      min-height: 2.5rem;
      border-radius: 0.5rem;
      background: #eee8dc;
      padding: 0.75rem 1rem;
      white-space: pre-wrap;
      color: #25301a;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .codeset .output.is-error {
      color: #8a2d22;
    }

    .course-video {
      margin: 1.5rem 0;
    }

    .course-video-title {
      margin-bottom: 0.5rem;
      color: #73592f;
      font-size: 0.9375rem;
      font-weight: 800;
      line-height: 1.35;
    }

    .course-video-frame {
      position: relative;
      overflow: hidden;
      border-radius: 0.5rem;
      background: #191919;
      aspect-ratio: 16 / 9;
    }

    .course-video-frame iframe,
    .course-video-native {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .course-video-native {
      height: auto;
      overflow: hidden;
      border-radius: 0.5rem;
      background: #191919;
      aspect-ratio: 16 / 9;
    }

    .course-challenge {
      margin: 1.5rem 0;
      border: 1px solid rgba(20, 20, 20, 0.12);
      border-radius: 0.5rem;
      background: #fffdf8;
      padding: 1rem;
    }

    .course-challenge-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 1.75rem;
      gap: 1rem;
      align-items: start;
    }

    .course-challenge-prompt > :last-child {
      margin-bottom: 0;
    }

    .course-challenge-result-icon {
      display: inline-grid;
      place-items: center;
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 999px;
      font-size: 1rem;
      font-weight: 900;
      line-height: 1;
      justify-self: end;
    }

    .course-challenge.is-correct .course-challenge-result-icon {
      background: #2f6f4e;
      color: #fff;
    }

    .course-challenge.is-incorrect .course-challenge-result-icon {
      background: #8a2d22;
      color: #fff;
    }

    .course-choice-list {
      display: grid;
      gap: 0.5rem;
      margin: 1rem 0;
      border: 0;
      padding: 0;
    }

    .course-choice {
      display: grid;
      grid-template-columns: 1rem 2rem minmax(0, 1fr);
      gap: 0.625rem;
      align-items: start;
      border: 1px solid rgba(20, 20, 20, 0.12);
      border-radius: 0.375rem;
      background: #f8f7f3;
      padding: 0.625rem 0.75rem;
      cursor: pointer;
    }

    .course-choice-input {
      margin: 0.25rem 0 0;
    }

    .course-choice-letter {
      color: #73592f;
      font-weight: 800;
      line-height: 1.45;
    }

    .course-choice-body {
      display: grid;
      gap: 0.35rem;
      min-width: 0;
    }

    .course-choice-explanation {
      color: #5f5445;
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .course-choice.is-correct-answer {
      border-color: rgba(47, 111, 78, 0.62);
      background: #eef7f1;
    }

    .course-choice.is-incorrect-answer {
      border-color: rgba(138, 45, 34, 0.5);
      background: #fff1ee;
    }

    .course-choice-input:disabled {
      cursor: default;
    }

    .course-challenge-actions {
      display: flex;
      justify-content: flex-start;
      gap: 0.5rem;
    }

    .course-challenge-submit {
      border: 1px solid rgba(20, 20, 20, 0.16);
      border-radius: 0.375rem;
      background: #191919;
      padding: 0.55rem 0.85rem;
      color: #f7c35f;
      font-weight: 800;
      cursor: pointer;
    }

    .course-challenge-submit:disabled {
      cursor: default;
      opacity: 0.62;
    }

    .course-challenge-feedback {
      margin-top: 0.75rem;
      border-radius: 0.375rem;
      background: #eee8dc;
      padding: 0.625rem 0.75rem;
      font-weight: 700;
    }

    .course-code-challenge.is-correct .challenge-output {
      color: #2f6f4e;
    }

    .course-code-challenge.is-incorrect .challenge-output {
      color: #8a2d22;
    }

    .course-code-challenge .code-challenge-cell {
      margin-bottom: 0;
    }

    .course-code-challenge .code-runner {
      transform: translateX(-1rem);
    }

    .course-authoring-error {
      border-color: rgba(138, 45, 34, 0.5);
      background: #fff1ee;
      color: #8a2d22;
    }

    .course-authoring-error p {
      margin-bottom: 0;
    }

    .course-platform_pager {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(20, 20, 20, 0.12);
    }

    .course-platform_pager-link {
      display: grid;
      gap: 0.25rem;
      max-width: 48%;
      color: #191919;
      text-decoration: none;
    }

    .course-platform_pager-link.next {
      margin-left: auto;
      text-align: right;
    }

    .course-platform_pager-label {
      color: #73592f;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .course-platform_pager-title {
      font-weight: 700;
      line-height: 1.3;
    }

    .course-scroll-indicator {
      --scroll-progress: 0;
      position: fixed;
      right: 1rem;
      top: 50%;
      z-index: 20;
      display: grid;
      justify-items: center;
      gap: 0.5rem;
      transform: translateY(-50%);
      pointer-events: none;
    }

    .course-scroll-track {
      position: relative;
      width: 0.375rem;
      height: 8rem;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(25, 25, 25, 0.12);
    }

    .course-scroll-fill {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      height: 100%;
      border-radius: inherit;
      background: #191919;
      transform: scaleY(var(--scroll-progress));
      transform-origin: top;
    }

    .course-challenge-markers {
      display: grid;
      gap: 0.375rem;
      justify-items: center;
    }

    .course-challenge-marker {
      width: 0.75rem;
      height: 0.75rem;
      border: 1px solid rgba(25, 25, 25, 0.32);
      border-radius: 0.125rem;
      background: #f8f7f3;
      box-shadow: 0 1px 2px rgba(20, 20, 20, 0.12);
    }

    .course-challenge-marker.is-correct {
      border-color: #2f6f4e;
      background: #2f6f4e;
    }

    .course-challenge-marker.is-incorrect {
      border-color: #8a2d22;
      background: #8a2d22;
    }

    @media screen and (max-width: 860px) {
      .course-platform_shell {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 5rem 1.25rem 3rem;
      }

      .course-platform_sidebar {
        position: relative;
        top: auto;
        max-height: none;
        padding: 0 0 1.25rem;
        border-right: 0;
        border-bottom: 1px solid rgba(20, 20, 20, 0.12);
      }

      .course-platform_content {
        max-width: none;
      }

      .codeset {
        width: 100%;
        grid-template-columns: 2.5rem minmax(0, 1fr);
        margin-left: 0;
      }

      .course-code-challenge .code-runner {
        transform: none;
      }

      .course-scroll-indicator {
        right: 1rem;
        left: 1rem;
        top: auto;
        bottom: 0.75rem;
        gap: 0.625rem;
        transform: none;
      }

      .course-scroll-track {
        width: 100%;
        height: 0.25rem;
      }

      .course-scroll-fill {
        transform: scaleX(var(--scroll-progress));
        transform-origin: left;
      }

      .course-challenge-markers {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        order: -1;
      }

      .course-platform_top-dashboard-link {
        right: 7rem;
        padding: 0.5rem 0;
        font-size: 0.875rem;
      }
    }
  </style>
  <script>
    let courseProgressState = { version: 1, courses: {} };
    const codeIndent = "    ";

    document.addEventListener("DOMContentLoaded", function() {
      hydrateCourseProgressFromServer().finally(function() {
        setupAutoResizeCodeAreas();
        setupCourseChallengeMarkers();
        updateCourseSidebarProgress();
        updateCourseScrollProgress();
      });
    });

    window.addEventListener("scroll", requestCourseScrollProgressUpdate, { passive: true });
    window.addEventListener("resize", requestCourseScrollProgressUpdate);
    window.addEventListener("course:block-result", function(event) {
      saveCourseBlockProgress(event.detail || {});
      saveCourseBlockProgressToServer(event.detail || {});
      updateCourseChallengeMarker(event);
      updateCourseSidebarProgress();
    });

    let scrollProgressFrame = 0;

    function requestCourseScrollProgressUpdate() {
      if (scrollProgressFrame) {
        return;
      }

      scrollProgressFrame = window.requestAnimationFrame(function() {
        scrollProgressFrame = 0;
        updateCourseScrollProgress();
      });
    }

    function updateCourseScrollProgress() {
      const indicator = document.querySelector(".course-scroll-indicator");
      if (!indicator) {
        return;
      }

      const scroller = document.scrollingElement || document.documentElement;
      const maxScroll = Math.max(0, scroller.scrollHeight - window.innerHeight);
      const progress = maxScroll === 0 ? 1 : Math.min(1, Math.max(0, scroller.scrollTop / maxScroll));
      indicator.style.setProperty("--scroll-progress", progress.toFixed(4));
    }

    function setupCourseChallengeMarkers() {
      const container = document.querySelector(".course-challenge-markers");
      if (!container) {
        return;
      }

      const challenges = Array.from(document.querySelectorAll(".course-multiple-choice, .course-code-challenge"));
      container.innerHTML = "";
      container.hidden = challenges.length === 0;
      challenges.forEach(function(challenge, index) {
        if (!challenge.dataset.courseBlockId) {
          challenge.dataset.courseBlockId = "challenge-" + (index + 1);
        }

        const marker = document.createElement("span");
        marker.className = "course-challenge-marker";
        marker.dataset.courseBlockId = challenge.dataset.courseBlockId;
        container.appendChild(marker);
      });
      updateCourseChallengeMarkersFromProgress();
    }

    function updateCourseChallengeMarker(event) {
      const detail = event.detail || {};
      if (!detail.blockId) {
        return;
      }

      const marker = Array.from(document.querySelectorAll(".course-challenge-marker")).find(function(item) {
        return item.dataset.courseBlockId === detail.blockId;
      });
      if (!marker) {
        return;
      }

      marker.classList.remove("is-correct", "is-incorrect");
      marker.classList.add(detail.correct ? "is-correct" : "is-incorrect");
    }

    function updateCourseChallengeMarkersFromProgress() {
      const shell = document.querySelector(".course-platform_shell");
      if (!shell) {
        return;
      }

      const lesson = getStoredCourseLesson(shell.dataset.courseSlug || "", shell.dataset.lessonPath || "");
      document.querySelectorAll(".course-challenge-marker").forEach(function(marker) {
        const block = lesson.blocks[marker.dataset.courseBlockId];
        marker.classList.remove("is-correct", "is-incorrect");
        if (block && block.correct === true) {
          marker.classList.add("is-correct");
        } else if (block && block.correct === false) {
          marker.classList.add("is-incorrect");
        }
      });
    }

    function updateCourseSidebarProgress() {
      const shell = document.querySelector(".course-platform_shell");
      if (!shell) {
        return;
      }

      const courseSlug = shell.dataset.courseSlug || "";
      document.querySelectorAll(".course-platform_nav-link[data-lesson-path]").forEach(function(link) {
        const expectedCount = Number.parseInt(link.dataset.challengeCount || "0", 10);
        const status = link.querySelector(".course-platform_challenge-status");
        link.classList.remove("is-complete", "is-attempted");
        if (!status || expectedCount <= 0) {
          if (status) {
            status.hidden = true;
          }
          return;
        }

        status.hidden = false;
        status.textContent = "";
        status.removeAttribute("aria-label");

        const lesson = getStoredCourseLesson(courseSlug, link.dataset.lessonPath || "");
        const blocks = Object.values(lesson.blocks);
        if (blocks.length === 0) {
          return;
        }

        const correctCount = blocks.filter(function(block) {
          return block.correct === true;
        }).length;
        if (correctCount >= expectedCount && blocks.every(function(block) { return block.correct === true; })) {
          link.classList.add("is-complete");
          status.textContent = "✓";
          status.setAttribute("aria-label", "All challenges complete");
          return;
        }

        link.classList.add("is-attempted");
        status.textContent = "×";
        status.setAttribute("aria-label", "Challenges attempted");
      });
    }

    function saveCourseBlockProgress(detail) {
      const courseSlug = detail.courseSlug || "";
      const lessonPath = detail.lessonPath || "";
      const blockId = detail.blockId || "";
      if (!courseSlug || !lessonPath || !blockId) {
