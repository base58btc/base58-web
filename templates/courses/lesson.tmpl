      }

      const progress = readCourseProgress();
      progress.courses[courseSlug] = progress.courses[courseSlug] || { lessons: {} };
      progress.courses[courseSlug].lessons[lessonPath] = progress.courses[courseSlug].lessons[lessonPath] || { blocks: {}, codeBlocks: {} };
      const lesson = progress.courses[courseSlug].lessons[lessonPath];
      lesson.blocks = lesson.blocks || {};
