    function mergeServerCourseProgress(courseSlug, blocks, codeBlocks) {
      const progress = readCourseProgress();
      progress.courses[courseSlug] = { lessons: {} };

      (blocks || []).forEach(function(block) {
        if (!block.lessonPath || !block.blockId) {
          return;
        }
        progress.courses[courseSlug].lessons[block.lessonPath] = progress.courses[courseSlug].lessons[block.lessonPath] || { blocks: {}, codeBlocks: {} };
        progress.courses[courseSlug].lessons[block.lessonPath].blocks[block.blockId] = {
          blockId: block.blockId,
          blockType: block.blockType || "",
          correct: Boolean(block.correct),
          selectedOption: block.selectedOption || null,
          selectedOptions: Array.isArray(block.selectedOptions) ? block.selectedOptions : [],
          answeredAt: block.updatedAt || block.answeredAt || new Date().toISOString()
        };
      });
      (codeBlocks || []).forEach(function(block) {
        if (!block.lessonPath || !block.blockId) {
