<!DOCTYPE html>
<html>
<head>
  {{ block "head" .Page }} {{ end }}
  <style>
    .local-course {
      min-height: 100vh;
      background: #f8f7f3;
      color: #191919;
    }

    .local-course-shell {
      width: min(100%, 72rem);
      margin: 0 auto;
      padding: 7rem 2rem 5rem;
    }

    .local-course-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
      gap: 2rem;
      align-items: end;
      margin-bottom: 3rem;
    }

    .local-course-kicker {
      margin: 0 0 0.75rem;
      color: #73592f;
      font-size: 0.875rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .local-course h1 {
      margin: 0;
      max-width: 12ch;
      font-size: clamp(2.75rem, 8vw, 6rem);
      line-height: 0.95;
      letter-spacing: 0;
    }

    .local-course-description {
      max-width: 42rem;
      margin: 1.25rem 0 0;
      color: #3b352b;
      font-size: 1.125rem;
      line-height: 1.6;
    }

    .local-course-image {
      overflow: hidden;
      border-radius: 0.5rem;
      background: #191919;
      aspect-ratio: 4 / 3;
    }

    .local-course-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .local-course-actions {
      display: flex;
      gap: 0.75rem;
      margin-top: 1.75rem;
    }

    .local-course-error {
      max-width: 42rem;
      margin: 1.5rem 0 0;
      border: 1px solid rgba(138, 45, 34, 0.35);
      border-radius: 0.5rem;
      background: #fff1ee;
      padding: 0.875rem 1rem;
      color: #8a2d22;
      font-weight: 750;
      line-height: 1.45;
    }

    .local-course-notice {
      max-width: 42rem;
      margin: 1.5rem 0 0;
      border: 1px solid rgba(47, 111, 78, 0.35);
      border-radius: 0.5rem;
      background: #eef7f1;
      padding: 0.875rem 1rem;
      color: #2f6f4e;
      font-weight: 750;
      line-height: 1.45;
    }

    .local-course-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
      border: 1px solid #191919;
      border-radius: 0.375rem;
      background: #191919;
      padding: 0 1rem;
      color: #f7c35f;
      font-weight: 800;
      text-decoration: none;
    }

    .local-course-button.secondary {
      background: transparent;
      color: #191919;
    }

    .local-course-dialog {
      width: min(100% - 2rem, 32rem);
      border: 0;
      border-radius: 0.5rem;
      padding: 0;
      background: #fffdf8;
      color: #191919;
      box-shadow: 0 1.5rem 4rem rgba(20, 20, 20, 0.22);
    }

    .local-course-dialog::backdrop {
      background: rgba(20, 20, 20, 0.45);
    }

    .local-course-dialog-inner {
      padding: 1.5rem;
    }

    .local-course-dialog h2 {
      margin: 0 0 0.5rem;
      font-size: 1.5rem;
      line-height: 1.2;
    }

    .local-course-dialog p {
      margin: 0 0 1.25rem;
      color: #4b4032;
      line-height: 1.5;
    }

    .local-course-form {
      display: grid;
      gap: 0.875rem;
    }

    .local-course-form label {
      display: grid;
      gap: 0.35rem;
      font-weight: 750;
    }

    .local-course-form input {
      border: 1px solid rgba(20, 20, 20, 0.18);
      border-radius: 0.375rem;
      background: #fff;
      padding: 0.75rem 0.85rem;
      font: inherit;
    }

    .local-course-dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .local-course-outline {
      display: grid;
      gap: 0.75rem;
      max-width: 52rem;
      margin-top: 2rem;
    }

    .local-course-outline h2 {
      margin: 0 0 0.25rem;
      font-size: 1.5rem;
      line-height: 1.2;
    }

    .local-course-lesson {
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: center;
      border-top: 1px solid rgba(20, 20, 20, 0.12);
      padding: 1rem 0;
      color: #191919;
      text-decoration: none;
    }

    .local-course-lesson-number {
      color: #8f6b32;
      font-size: 0.875rem;
      font-weight: 800;
    }

    .local-course-lesson-title {
      font-size: 1.0625rem;
      font-weight: 800;
      line-height: 1.35;
    }

    .local-course-lesson-meta {
      color: #73592f;
      font-size: 0.875rem;
      font-weight: 700;
    }

    .local-course-sublessons {
      grid-column: 2 / -1;
      display: grid;
      gap: 0.35rem;
      margin-top: 0.25rem;
    }

    .local-course-sublesson {
      color: #4b4032;
      font-weight: 650;
      text-decoration: none;
    }

    @media screen and (max-width: 820px) {
      .local-course-shell {
        padding: 5rem 1.25rem 3rem;
      }

      .local-course-hero {
        grid-template-columns: 1fr;
      }

      .local-course-lesson {
        grid-template-columns: 2.5rem minmax(0, 1fr);
      }

      .local-course-lesson-meta {
        grid-column: 2;
      }
    }
  </style>
</head>
<body>
  <div class="page-wrapper local-course">
    {{ block "nav" .Page }} {{ end }}
    <main class="local-course-shell">
      <section class="local-course-hero">
        <div>
          <p class="local-course-kicker">Course</p>
          <h1>{{ .CourseTitle }}</h1>
          {{ if .Description }}
            <p class="local-course-description">{{ .Description }}</p>
          {{ end }}
          {{ if .Error }}
            <div class="local-course-error">{{ .Error }}</div>
          {{ end }}
          {{ if .Notice }}
            <div class="local-course-notice">{{ .Notice }}</div>
          {{ end }}
          {{ if .StartURL }}
            <div class="local-course-actions">
              <button class="local-course-button" type="button" data-open-course-signup>Register</button>
              <a class="local-course-button secondary" href="{{ .StartURL }}">Start course</a>
            </div>
          {{ end }}
        </div>
        {{ if .HeroURL }}
          <figure class="local-course-image">
            <img src="{{ .HeroURL }}" alt="{{ .HeroAlt }}" loading="lazy">
          </figure>
        {{ end }}
      </section>

      <section class="local-course-outline">
        <h2>Lessons</h2>
        {{ range .Sidebar }}
          <a class="local-course-lesson" href="{{ .URL }}">
            <span class="local-course-lesson-number">{{ .DisplayNumber }}</span>
            <span class="local-course-lesson-title">{{ .Title }}</span>
            {{ if gt .ChallengeCount 0 }}
              <span class="local-course-lesson-meta">{{ .ChallengeCount }} challenges</span>
            {{ else }}
              <span class="local-course-lesson-meta"></span>
            {{ end }}
            {{ if .Children }}
              <span class="local-course-sublessons">
                {{ range .Children }}
                  <span class="local-course-sublesson">{{ .DisplayNumber }} {{ .Title }}</span>
                {{ end }}
              </span>
            {{ end }}
          </a>
        {{ end }}
      </section>
    </main>
  </div>
  <dialog class="local-course-dialog" id="course-signup-dialog">
    <div class="local-course-dialog-inner">
      <h2>Register for {{ .CourseTitle }}</h2>
      <p>Create your course account and get access to the lessons.</p>
      <form class="local-course-form" method="post" action="/courses/{{ .CourseSlug }}/signup">
        <label>Name
          <input name="display_name" autocomplete="name">
        </label>
        <label>Email
          <input name="email" type="email" autocomplete="email" required>
        </label>
        <div class="local-course-dialog-actions">
          <button class="local-course-button secondary" type="button" data-close-course-signup>Cancel</button>
          <button class="local-course-button" type="submit">Create account</button>
        </div>
      </form>
    </div>
  </dialog>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const dialog = document.getElementById("course-signup-dialog");
      const openButtons = document.querySelectorAll("[data-open-course-signup]");
      const closeButtons = document.querySelectorAll("[data-close-course-signup]");
      openButtons.forEach(function(button) {
        button.addEventListener("click", function() {
          if (dialog && typeof dialog.showModal === "function") {
            dialog.showModal();
          }
        });
      });
      closeButtons.forEach(function(button) {
        button.addEventListener("click", function() {
          if (dialog) {
            dialog.close();
          }
        });
      });
      {{ if .Error }}
      if (dialog && typeof dialog.showModal === "function") {
        dialog.showModal();
      }
      {{ end }}
    });
  </script>
  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=67d76c360ee76ed0c60f7a0e" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="/static/js/webflow.js" type="text/javascript"></script>
</body>
</html>
