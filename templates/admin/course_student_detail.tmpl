<!DOCTYPE html>
<html>
<head>
  {{ block "head" .Page }} {{ end }}
  {{ template "admin/style.tmpl" . }}
</head>
<body class="admin-body">
  {{ template "admin/nav.tmpl" . }}
  <main class="admin-main">
    <section class="admin-header">
      <div>
        <h1>{{ .Person.DisplayName }}</h1>
        <div class="admin-muted">{{ .Course.Title }} · {{ .Person.PrimaryEmail }}</div>
      </div>
      <a href="/admin/courses/{{ .Course.Slug }}/students">Back to students</a>
    </section>
    <div class="admin-course-layout">
      {{ template "admin/course_sidebar.tmpl" . }}
      <section>
        <h2>Attempts, Progress, Logs, and Saved Code</h2>
        {{ template "admin/attempts.tmpl" . }}
      </section>
    </div>
  </main>
</body>
</html>
